# Yassota — Apache config for the wildcard network
# =================================================
# One docroot serves the main site AND every *.yassota.com subdomain.
# index.php inspects the Host header and renders the right thing.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files/dirs directly (assets, tools.php, sitemap.php, ads.txt…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → front controller (handles subsite routing too)
    RewriteRule ^ index.php [L]
</IfModule>

# ---- Security ----
# Never serve config, logs, or the sqlite DB
<FilesMatch "^(config\.php|.*\.sqlite|.*\.log|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
Options -Indexes

# ---- Caching for static assets ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# ---- UTF-8 ----
AddDefaultCharset UTF-8
